{
  "manifest_version": 3,
  "name": "GameOpen",
  "version": "1.0.0",
  "description": "Un lanceur d'applications (Roblox, Discord, Steam...) avec des mini-jeux integres pour patienter.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "GameOpen",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
