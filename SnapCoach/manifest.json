{
  "manifest_version": 3,
  "name": "SnapCoach",
  "version": "1.0.0",
  "description": "Sur web.snapchat.com : niveau d'interet de la personne, reponses possibles, erreurs a eviter et bon moment pour repondre.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://web.snapchat.com/*",
    "https://api.anthropic.com/*"
  ],
  "background": {
    "service_worker": "bg.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "SnapCoach",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://web.snapchat.com/*"
      ],
      "js": [
        "coach.js",
        "content.js"
      ],
      "css": [
        "panel.css"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
